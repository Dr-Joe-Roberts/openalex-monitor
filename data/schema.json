{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dr-Joe-Roberts/openalex-monitor/blob/main/data/schema.json",
  "title": "OpenAlex monthly author-monitoring record",
  "type": "object",
  "required": [
    "schema_version",
    "period",
    "snapshot_date",
    "fetched_at",
    "comparison",
    "profile",
    "metrics",
    "publications",
    "openalex_snapshot",
    "curation",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "snapshot_date": {"type": "string", "format": "date"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "comparison": {
      "type": "object",
      "required": ["previous_snapshot_date", "metrics_change"]
    },
    "profile": {
      "type": "object",
      "required": ["id", "display_name"]
    },
    "metrics": {
      "type": "object",
      "required": ["raw", "curated"]
    },
    "publications": {
      "type": "object",
      "required": ["all", "citation_gains", "newly_indexed", "corrections_or_removals"],
      "properties": {
        "all": {"type": "array"},
        "citation_gains": {"type": "array"},
        "newly_indexed": {"type": "array"},
        "corrections_or_removals": {"type": "array"}
      }
    },
    "openalex_snapshot": {"type": "object"},
    "curation": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
